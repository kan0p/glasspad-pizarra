<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- sin contraseña solo para la sesión local activa; el programa entrega solo atajos -->
<policyconfig>
  <vendor>GlassPad Pizarra</vendor>
  <vendor_url>https://github.com/kan0p/glasspad-pizarra</vendor_url>
  <action id="io.github.kan0p.glasspad.pizarra.teclas">
    <description>Mostrar en pantalla los atajos de teclado</description>
    <message>GlassPad Pizarra necesita leer el teclado para mostrar los atajos</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@LIBEXEC@/glasspad-pizarra-teclas</annotate>
  </action>
</policyconfig>
