        m = monitor_principal()
        if m:
            Capa.set_monitor(v, m)
        Capa.set_keyboard_mode(v, Capa.KeyboardMode.NONE)
        Capa.set_layer(v, Capa.Layer.OVERLAY)
        self.caja = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10,
                            width_request=1, height_request=1, can_target=False)
        v.set_child(self.caja)
        v.connect("realize", lambda _v: self._region())
        self.ventana = v
        self.reubicar()
        v.present()

    def _region(self):
        superficie = self.ventana.get_surface() if self.ventana else None
        if superficie:
            superficie.set_input_region(cairo.Region())

    def reubicar(self):
        if not self.ventana:
            return
        e = self.app.estado
        derecha = e["posicion"] == "derecha"
        Capa.set_anchor(self.ventana, Capa.Edge.BOTTOM, True)
        Capa.set_anchor(self.ventana, Capa.Edge.RIGHT, derecha)
        Capa.set_margin(self.ventana, Capa.Edge.BOTTOM, 40)
        Capa.set_margin(self.ventana, Capa.Edge.RIGHT, 40 if derecha else 0)
        self.caja.set_halign(Gtk.Align.END if derecha else Gtk.Align.CENTER)
        for t in TAMANOS:
            self.caja.remove_css_class(f"pizarra-teclas-{t}")
        self.caja.add_css_class(f"pizarra-teclas-{e['tamano']}")

    def mostrar(self, atajo, descripcion, windows):
        if self.ventana is None:
            self._crear()
        con_windows = self.app.estado["windows"]
        ultima = self.vivas[-1] if self.vivas else None
        if ultima and ultima["atajo"] == atajo and not ultima["saliendo"]:
            ultima["veces"] += 1
            ultima["etiqueta_veces"].set_label(f"×{ultima['veces']}")
            ultima["etiqueta_veces"].set_visible(True)
            self._programar(ultima)
            return
        tarjeta = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8,
                          halign=self.caja.get_halign(), css_classes=["pizarra-tarjeta"])
        fila = Gtk.Box(spacing=8, halign=Gtk.Align.CENTER)
        for i, (parte, texto) in enumerate(zip(atajo.split("+"), etiquetas(atajo, con_windows))):
            if i:
                fila.append(Gtk.Label(label="+", css_classes=["pizarra-mas"]))
            if parte == "super" and con_windows:
                tecla = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, css_classes=["pizarra-tecla"],
                                valign=Gtk.Align.CENTER)
                tecla.append(Gtk.Label(label=texto))
                tecla.append(Gtk.Label(label="Super", css_classes=["pizarra-tecla-sub"]))
                fila.append(tecla)
            else:
                fila.append(Gtk.Label(label=texto, css_classes=["pizarra-tecla"],
                                      valign=Gtk.Align.CENTER))
        veces = Gtk.Label(css_classes=["pizarra-veces"], visible=False)
        fila.append(veces)
        tarjeta.append(fila)
        abajo = Gtk.Box(spacing=10, halign=Gtk.Align.CENTER)
        if descripcion:
            abajo.append(Gtk.Label(label=descripcion, css_classes=["pizarra-desc"]))
        if con_windows and windows == "" and descripcion:
            abajo.append(Gtk.Label(label="· igual en Windows", css_classes=["pizarra-igual"]))
        elif con_windows and windows:
            abajo.append(Gtk.Label(label="En Windows: " + " + ".join(etiquetas(windows, True)),
                                   css_classes=["pizarra-win"]))
        if abajo.get_first_child():
            tarjeta.append(abajo)
        for vieja in self.vivas:
            vieja["caja"].add_css_class("anterior")
        while len(self.vivas) >= TARJETAS:
            self._quitar(self.vivas[0])
        viva = {"caja": tarjeta, "atajo": atajo, "veces": 1, "etiqueta_veces": veces,
                "espera": 0, "saliendo": False}
        self.vivas.append(viva)
        self.caja.append(tarjeta)
        self._programar(viva)
        self._region()

    def _programar(self, viva):
        if viva["espera"]:
            GLib.source_remove(viva["espera"])
        viva["espera"] = GLib.timeout_add(int(TARJETA_S * 1000), self._desvanecer, viva)

    def _desvanecer(self, viva):
        viva["espera"] = 0
        viva["saliendo"] = True
        viva["caja"].add_css_class("saliendo")
        viva["espera"] = GLib.timeout_add(260, lambda: self._quitar(viva) and False)
        return False

    def _quitar(self, viva):
        if viva in self.vivas:
            if viva["espera"]:
                GLib.source_remove(viva["espera"])
            self.vivas.remove(viva)
            self.caja.remove(viva["caja"])

    def vaciar(self):
        # desvanecer en vez de quitar: COSMIC no vuelve a pedir un cuadro al achicarse la capa,
        # así que el último dibujado debe ser transparente
        for viva in list(self.vivas):
            if not viva["saliendo"]:
                if viva["espera"]:
                    GLib.source_remove(viva["espera"])
                self._desvanecer(viva)


class Trazo:
    def __init__(self, herramienta, color, ancho, x, y):
        self.herramienta = herramienta
        self.color = rgb(COLORES[color])
        self.ancho = ancho
        self.puntos = [(x, y)]
        self.fin = None          # momento en que se soltó (para el láser)

    def segmentos(self):
        p = self.puntos
        if self.herramienta == "flecha":
            return [(p[0], p[-1])]
        if self.herramienta == "recuadro":
            (x0, y0), (x1, y1) = p[0], p[-1]
            esquinas = [(x0, y0), (x1, y0), (x1, y1), (x0, y1)]
            return list(zip(esquinas, esquinas[1:] + esquinas[:1]))
        return list(zip(p, p[1:])) or [(p[0], p[0])]

    def toca(self, x, y, radio):
        alcance = radio + self.ancho / 2
        return any(distancia_segmento(x, y, *a, *b) <= alcance for a, b in self.segmentos())

    def dibujar(self, cr, vida=1.0):
        h = self.herramienta
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_join(cairo.LINE_JOIN_ROUND)
        if h == "laser":
            for ancho, color, alfa in ((self.ancho * 3.2, self.color, 0.22),
                                       (self.ancho, self.color, 0.95),
                                       (max(1.5, self.ancho * 0.35), (1, 1, 1), 0.9)):
                self._camino(cr)
                cr.set_source_rgba(*color, alfa * vida)
                cr.set_line_width(ancho)
                cr.stroke()
            return
        cr.set_source_rgba(*self.color, 0.4 if h == "resaltador" else 1.0)
        cr.set_line_width(self.ancho)
        if h == "flecha":
            (x0, y0), (x1, y1) = self.puntos[0], self.puntos[-1]
            cr.move_to(x0, y0)
            cr.line_to(x1, y1)
            cr.stroke()
            if math.hypot(x1 - x0, y1 - y0) > 1:
                ang = math.atan2(y1 - y0, x1 - x0)
                punta = 14 + self.ancho * 2.5
                for d in (math.radians(150), math.radians(-150)):
                    cr.move_to(x1, y1)
                    cr.line_to(x1 + punta * math.cos(ang + d), y1 + punta * math.sin(ang + d))
                cr.stroke()
        elif h == "recuadro":
            (x0, y0), (x1, y1) = self.puntos[0], self.puntos[-1]
            cr.rectangle(min(x0, x1), min(y0, y1), abs(x1 - x0), abs(y1 - y0))
            cr.stroke()
        else:
            self._camino(cr)
            cr.stroke()

    def _camino(self, cr):
        p = self.puntos
        cr.move_to(*p[0])
        if len(p) == 1:
            cr.line_to(*p[0])
            return
        # curvas por los puntos medios: trazo suave sin esquinas
        for (x0, y0), (x1, y1) in zip(p[:-1], p[1:]):
            mx, my = (x0 + x1) / 2, (y0 + y1) / 2
            cx, cy = cr.get_current_point()
            cr.curve_to(cx + (x0 - cx) * 2 / 3, cy + (y0 - cy) * 2 / 3,
                        mx + (x0 - mx) * 2 / 3, my + (y0 - my) * 2 / 3, mx, my)
        cr.line_to(*p[-1])


class Pizarra(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=BUS, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.estado = leer_estado()
        self.paginas = {f: [] for f in FONDOS}      # trazos de cada fondo
        self.historial = {f: [] for f in FONDOS}
        self.actual = None          # trazo que se está dibujando
        self.borrados = False       # el borrador ya quitó algo en este arrastre
        self.lasers = []
        self.cache = None           # (pagina, ancho, alto, escala, ImageSurface)
        self.ventana = None
        self.area = None
        self.tic = 0
        self.espera_aviso = 0
        self.conexion = None
        self.foco = None
        self.achicada = False
        self.lector = Lector(self._atajo, self._clic, self._fallo_lector)
        self.tarjetas = Tarjetas(self)
        self.signos = SIGNOS["us"]
        self.sin_lector = False     # el lector falló: no se reintenta hasta que se pida otra vez
        self.capturando = None      # acción cuyo atajo se está esperando
        self.espera_captura = 0

    # ----- arranque ----------------------------------------------------------

    def do_startup(self):
        Gtk.Application.do_startup(self)
        self.hold()
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), prov,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        Gdk.Display.get_default().get_monitors().connect("items-changed", self._monitores)
        for s in (2, 15):
            signal_add(GLib.PRIORITY_DEFAULT, s, lambda *_a: self.quit() or False)
        debug("listo")

    def do_dbus_register(self, conexion, ruta):
        # antes de tomar el nombre: así ninguna llamada llega sin el objeto registrado
        Gtk.Application.do_dbus_register(self, conexion, ruta)
        info = Gio.DBusNodeInfo.new_for_xml(XML).interfaces[0]
        self.conexion = conexion
        self.registro = conexion.register_object(RUTA, info, self._llamada, None, None)
        return True

    def do_dbus_unregister(self, conexion, ruta):
        conexion.unregister_object(self.registro)
        Gtk.Application.do_dbus_unregister(self, conexion, ruta)

    def do_activate(self):
        pass

    def _monitores(self, *_a):
        # la salida del pad aparece y desaparece en cada cambio de modo
        GLib.timeout_add(500, self._revisar_monitor)

    def _revisar_monitor(self):
        m = monitor_principal()
        if not m:
            return False
        if self.ventana and m != Capa.get_monitor(self.ventana):
            debug("monitor principal:", m.get_connector())
            self.ventana.destroy()
            self.ventana = None
            self.achicada = False
            self._actualizar()
        if self.foco and self.foco.conector != m.get_connector():
            self._seguir_cursor(False)
            self._seguir_cursor(True)
        return False

    # ----- D-Bus -------------------------------------------------------------

    def _llamada(self, _con, _remitente, _ruta, _interfaz, metodo, params, invocacion):
        debug("D-Bus", metodo, params.unpack() if params else "")
        if metodo == "Estado":
            invocacion.return_value(GLib.Variant("(a{sv})", (self._estado_dbus(),)))
            return
        if metodo == "Ajustar":
            cambios = params.unpack()[0]
            malos = [k for k, v in cambios.items() if not valido(k, v)]
            if malos:
                invocacion.return_dbus_error(f"{INTERFAZ}.Error.Invalido",
                                             "valor no válido: " + ", ".join(malos))
                return
            problema = self._no_soportado(cambios)
            if problema:
                invocacion.return_dbus_error(f"{INTERFAZ}.Error.NoSoportado", problema)
                return
            self._ajustar(cambios)
        elif metodo == "Deshacer":
            self._deshacer()
        elif metodo == "Borrar":
            self._borrar()
        elif metodo == "ApagarTodo":
            for f in FONDOS:
                self.paginas[f] = []
                self.historial[f] = []
            self.lasers = []
            self._ajustar({"escribir": False, "foco": False, "teclas": False})
        elif metodo == "CapturarAtajo":
            accion = params.unpack()[0]
            if accion not in ACCIONES:
                invocacion.return_dbus_error(f"{INTERFAZ}.Error.Invalido", "acción desconocida")
                return
            self._capturar(accion)
        elif metodo == "CancelarCaptura":
            self._fin_captura()
        elif metodo == "RegistrarAtajos":
            self._registrar(params.unpack()[0])
        elif metodo == "RestablecerAtajos":
            self._guardar_atajos({})
        elif metodo == "CambioDiapositiva":
            if self.estado["borrar_al_pasar"] and self.paginas["transparente"]:
                self._guardar_historial("transparente")
                self.paginas["transparente"] = []
                self._cambio()
        invocacion.return_value(None)

    def _no_soportado(self, cambios):
        """Por qué no se puede encender lo pedido, o None."""
        encender = [k for k in ("escribir", "foco", "teclas") if cambios.get(k) is True]
        if not encender:
            return None
        if not Capa.is_supported():
            return "Este escritorio no permite capas superpuestas (wlr-layer-shell)"
        if not monitor_principal():
            return "No se encontró la pantalla principal"
        return None

    def _estado_dbus(self):
        d = {k: variante(v) for k, v in self.estado.items()}
        pagina = self._pagina()
        d["puede_deshacer"] = variante(bool(self.historial[pagina]))
        d["hay_dibujo"] = variante(any(self.paginas.values()))
        d["atajos"] = variante(self._atajos())
        d["atajos_registrados"] = variante(self._registrados())
        d["capturando"] = variante(self.capturando or "")
        return d

    def _cambio(self):
        self.cache = None
        self._actualizar()
        if self.conexion:
            self.conexion.emit_signal(None, RUTA, INTERFAZ, "Cambio",
                                      GLib.Variant("(a{sv})", (self._estado_dbus(),)))

    def _ajustar(self, cambios):
        antes = dict(self.estado)
        self.estado.update(cambios)
        if any(self.estado[k] != antes[k] for k in GUARDADOS):
            try:
                guardar_estado(self.estado)
            except OSError as e:
                log(f"no se pudo guardar {ESTADO}: {e}")
                self._avisar(f"No se pudieron guardar los ajustes: {e.strerror}")
        aviso = self.estado["escribir"] and (not antes["escribir"] or any(
            self.estado[k] != antes[k] for k in ("herramienta", "color", "fondo")))
        if self.estado["foco"] != antes["foco"]:
            self._seguir_cursor(self.estado["foco"])
        elif self.foco and any(self.estado[k] != antes[k] for k in ("radio", "oscuro", "anillo")):
            self.foco.repintar()
        if self.estado["teclas"] and not antes["teclas"]:
            self.signos = SIGNOS.get(distribucion(), SIGNOS["us"])
        if not self.estado["teclas"]:
            self.tarjetas.vaciar()
        if any(self.estado[k] != antes[k] for k in ("posicion", "tamano")):
            self.tarjetas.reubicar()
        if any(cambios.get(k) is True for k in ("teclas", "foco", "clics")):
            self.sin_lector = False
        self._lector_segun_estado()
        self._cambio()
        if aviso:
            self._mostrar_aviso()

    # ----- teclas ------------------------------------------------------------

    def _lector_segun_estado(self):
        if not self.sin_lector and (self.capturando or self.estado["teclas"]
                                    or (self.estado["foco"] and self.estado["clics"])):
            self.lector.encender()
        else:
            self.lector.apagar()

    # ----- atajos de la Pizarra en COSMIC ------------------------------------

    def _atajos(self):
        return {**ATAJOS_INICIALES, **self.estado["atajos"]}

    def _programa(self):
        return os.path.realpath(sys.argv[0])

    def _registrados(self):
        return "glasspad-pizarra " in leer(COSMIC_PROPIOS)

    def _capturar(self, accion):
        self._fin_captura(avisar=False)
        self.capturando = accion
        self.sin_lector = False
        self._lector_segun_estado()
        self.espera_captura = GLib.timeout_add_seconds(CAPTURA_S, self._fin_captura)
        self._cambio()

    def _fin_captura(self, avisar=True):
        if self.espera_captura:
            GLib.source_remove(self.espera_captura)
            self.espera_captura = 0
        if self.capturando:
            self.capturando = None
            self._lector_segun_estado()
            if avisar:
                self._cambio()
        return False

    def _capturado(self, atajo):
        accion = self.capturando
        nombre = ACCIONES[accion][0]
        partes = atajo.split("+")
        if not set(partes[:-1]) & {"super", "ctrl", "alt"} and atajo != "super":
            self._avisar("El atajo necesita Super, Ctrl o Alt")
            return
        if atajo == "super":
            self._avisar("Super solo abre el lanzador de COSMIC")
            return
        propios = {a: k for k, a in self._atajos().items() if k != accion}
        if atajo in propios:
            self._avisar(f"Ya lo usa {ACCIONES[propios[atajo]][0]} de la Pizarra")
            return
        ocupados = atajos_cosmic(leer(COSMIC_ATAJOS))
        ocupados.update({a: x for a, x in atajos_cosmic(leer(COSMIC_PROPIOS)).items()
                         if "glasspad-pizarra " not in x})
        if atajo in ocupados:
            self._avisar(" + ".join(etiquetas(atajo, False)) + " ya tiene un atajo en COSMIC")
            return
        self._fin_captura(avisar=False)
        self._guardar_atajos({**self.estado["atajos"], accion: atajo})
        self._avisar(f"{nombre}: " + " + ".join(etiquetas(atajo, False)))

    def _guardar_atajos(self, atajos):
        registrados = self._registrados()
        self._ajustar({"atajos": {k: a for k, a in atajos.items() if ATAJOS_INICIALES[k] != a}})
        if registrados:
            self._registrar(True)

    def _registrar(self, si):
        """Pone o quita las entradas de la Pizarra en los atajos propios de COSMIC."""
        if si and not os.path.exists(COSMIC_ATAJOS):
            self._avisar("Los atajos se registran en COSMIC, y este escritorio no lo es")
            return
        texto = leer(COSMIC_PROPIOS)
        lineas = [l for l in texto.splitlines(keepends=True) if "glasspad-pizarra " not in l]
        cuerpo = "".join(lineas).rstrip()
        if cuerpo.endswith("}"):
            cuerpo = cuerpo[:-1].rstrip()
        else:
            cuerpo = "{"
        if si:
            if not cuerpo.endswith(",") and not cuerpo.endswith("{"):
                cuerpo += ","
            programa = self._programa()
            cuerpo += "\n" + "".join(entrada_cosmic(a, programa, ACCIONES[k][1])
                                     for k, a in self._atajos().items())
        nuevo = cuerpo.rstrip() + "\n}\n"
        try:
            os.makedirs(os.path.dirname(COSMIC_PROPIOS), exist_ok=True)
            tmp = COSMIC_PROPIOS + ".tmp"
            with open(tmp, "w") as f:
                f.write(nuevo)
            os.replace(tmp, COSMIC_PROPIOS)
        except OSError as e:
            self._avisar(f"No se pudieron guardar los atajos: {e.strerror}")
        self._cambio()

    def _avisar(self, texto):
        if self.conexion:
            self.conexion.emit_signal(None, RUTA, INTERFAZ, "Aviso", GLib.Variant("(s)", (texto,)))

    def _atajo(self, texto):
        atajo = "+".join(nombre_tecla(p, self.signos) for p in texto.split("+"))
        if self.capturando:
            self._capturado(atajo)
            return
        if not self.estado["teclas"]:
            return
        propios = {a: k for k, a in self._atajos().items()}
        if atajo in propios:
            descripcion, windows = "Pizarra: " + ACCIONES[propios[atajo]][0], None
        else:
            descripcion, windows = EQUIVALENCIAS.get(atajo, (None, None))
        self.tarjetas.mostrar(atajo, descripcion, windows)

    def _clic(self, boton):
        if self.foco and self.estado["foco"] and self.estado["clics"]:
            self.foco.clic(boton)

    def _fallo_lector(self, texto):
        log("teclas:", texto)
        self.sin_lector = True
        self._avisar(texto)
        GLib.idle_add(lambda: self._fin_captura() and False)
        # puede llegar desde dentro de _ajustar
        GLib.idle_add(lambda: self.estado["teclas"] and self._ajustar({"teclas": False}) and False)

    # ----- foco --------------------------------------------------------------

    def _seguir_cursor(self, si):
        if not si:
            if self.foco:
                self.foco.detener()
                self.foco = None
            return
        m = monitor_principal()
        if m and not self.foco:
            escala = m.get_scale() if hasattr(m, "get_scale") else m.get_scale_factor()
            self.foco = Foco(m.get_connector(), escala, self.estado, self._fallo_foco)
            self.foco.iniciar()

    def _fallo_foco(self, texto):
        self.foco = None
        self._avisar("Foco: " + texto)
        GLib.idle_add(lambda: self.estado["foco"] and self._ajustar({"foco": False}) and False)

    # ----- páginas e historial ----------------------------------------------

    def _pagina(self):
        """Con Escribir apagado se ve siempre lo dibujado sobre la diapositiva."""
        return self.estado["fondo"] if self.estado["escribir"] else "transparente"

    def _guardar_historial(self, pagina):
        h = self.historial[pagina]
        h.append(list(self.paginas[pagina]))
        del h[:-HISTORIAL]

    def _deshacer(self):
        pagina = self._pagina()
        if self.historial[pagina]:
            self.paginas[pagina] = self.historial[pagina].pop()
            self._cambio()

    def _borrar(self):
        pagina = self._pagina()
        if self.paginas[pagina]:
            self._guardar_historial(pagina)
            self.paginas[pagina] = []
        self.lasers = []
        self._cambio()

    # ----- ventana -----------------------------------------------------------

    def _necesita_ventana(self):
        return (self.estado["escribir"] or bool(self.lasers)
                or bool(self.paginas["transparente"]))

    def _crear_ventana(self):
        m = monitor_principal()
        v = Gtk.ApplicationWindow(application=self, css_classes=["pizarra"])
        Capa.init_for_window(v)
        Capa.set_namespace(v, "glasspad-pizarra")
        if m:
            Capa.set_monitor(v, m)
        for borde in (Capa.Edge.TOP, Capa.Edge.BOTTOM, Capa.Edge.LEFT, Capa.Edge.RIGHT):
            Capa.set_anchor(v, borde, True)
        Capa.set_exclusive_zone(v, -1)
        Capa.set_keyboard_mode(v, Capa.KeyboardMode.NONE)
        Capa.set_layer(v, Capa.Layer.OVERLAY)

        self.area = Gtk.DrawingArea(hexpand=True, vexpand=True)
        self.area.set_draw_func(self._dibujar)
        arrastre = Gtk.GestureDrag(button=Gdk.BUTTON_PRIMARY)
        arrastre.connect("drag-begin", self._empezar)
        arrastre.connect("drag-update", self._seguir)
        arrastre.connect("drag-end", self._terminar)
        self.area.add_controller(arrastre)

        self.aviso = Gtk.Revealer(transition_type=Gtk.RevealerTransitionType.CROSSFADE,
                                  transition_duration=250, halign=Gtk.Align.END,
                                  valign=Gtk.Align.START, can_target=False)
        caja = Gtk.Box(spacing=10, css_classes=["pizarra-aviso"])
        self.aviso_punto = Gtk.Box(css_classes=["pizarra-punto"], valign=Gtk.Align.CENTER)
        self.aviso_titulo = Gtk.Label(css_classes=["titulo"])
        self.aviso_pista = Gtk.Label(css_classes=["pista"])
        for w in (self.aviso_punto, self.aviso_titulo, self.aviso_pista):
            caja.append(w)
        self.aviso.set_child(caja)

        capas = Gtk.Overlay(child=self.area)
        capas.add_overlay(self.aviso)
        v.set_child(capas)
        v.connect("realize", lambda _v: self._region())
        self.ventana = v

    def _actualizar(self):
        """Muestra u oculta la capa y decide si toma el mouse."""
        if self.ventana is None:
            if not self._necesita_ventana():
                return
            self._crear_ventana()
            self.ventana.present()
        self._achicar(not self._necesita_ventana())
        self._region()
        self.area.set_cursor_from_name(
            ("cell" if self.estado["herramienta"] == "borrador" else "crosshair")
            if self.estado["escribir"] else None)
        self.area.queue_draw()

    def _achicar(self, si):
        """1x1 y al fondo cuando no se usa: COSMIC corta la conexión al ocultar la capa."""
        v = self.ventana
        if si == self.achicada:
            return
        self.achicada = si
        Capa.set_anchor(v, Capa.Edge.BOTTOM, not si)
        Capa.set_anchor(v, Capa.Edge.RIGHT, not si)
        Capa.set_layer(v, Capa.Layer.BACKGROUND if si else Capa.Layer.OVERLAY)
        v.set_default_size(1, 1)
        if si:
            self.cache = None

    def _region(self):
        superficie = self.ventana.get_surface() if self.ventana else None
        if superficie is None:
            return
        # región vacía: los clics pasan a la ventana de abajo
        toma = self.estado["escribir"] and not self.achicada
        superficie.set_input_region(None if toma else cairo.Region())

    def _mostrar_aviso(self):
        if not self.ventana:
            return
        e = self.estado
        for c in COLORES:
            self.aviso_punto.remove_css_class(c)
        self.aviso_punto.add_css_class(e["color"])
        self.aviso_punto.set_visible(e["herramienta"] != "borrador")
        nombre = HERRAMIENTAS[e["herramienta"]]
        if e["herramienta"] not in ("borrador",):
            nombre += " " + e["color"]
        if e["fondo"] != "transparente":
            nombre += " · pizarra " + e["fondo"]
        self.aviso_titulo.set_label("Escribiendo")
        self.aviso_pista.set_label(f"{nombre} · el mouse dibuja; apágalo desde el pad")
        self.aviso.set_reveal_child(True)
        if self.espera_aviso:
            GLib.source_remove(self.espera_aviso)
        self.espera_aviso = GLib.timeout_add(int(AVISO_S * 1000), self._ocultar_aviso)

    def _ocultar_aviso(self):
        self.espera_aviso = 0
        if self.ventana:
            self.aviso.set_reveal_child(False)
        return False

    # ----- dibujo ------------------------------------------------------------

    def _dibujar(self, area, cr, ancho, alto):
        if self.achicada:
            return
        pagina = self._pagina()
        cr.set_operator(cairo.OPERATOR_SOURCE)
        fondo = FONDOS[pagina]
        if fondo:
            cr.set_source_rgb(*fondo)
        else:
            cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        if self.paginas[pagina]:
            cr.set_source_surface(self._cache(pagina, ancho, alto), 0, 0)
            cr.paint()
        if self.actual and self.actual.herramienta != "laser":
            self.actual.dibujar(cr)
        ahora = time.monotonic()
        for t in self.lasers:
            if t.fin is None:
                vida = 1.0
            else:
                vida = max(0.0, 1 - max(0.0, ahora - t.fin - LASER_VIVE_S) / LASER_APAGA_S)
            t.dibujar(cr, vida)

    def _cache(self, pagina, ancho, alto):
        """Los trazos terminados en una imagen; se rehace solo cuando cambian."""
        superficie = self.ventana.get_surface()
        escala = superficie.get_scale() if hasattr(superficie, "get_scale") \
            else superficie.get_scale_factor()
        clave = (pagina, ancho, alto, escala)
        if self.cache and self.cache[0] == clave:
            return self.cache[1]
        img = cairo.ImageSurface(cairo.FORMAT_ARGB32, max(1, math.ceil(ancho * escala)),
                                 max(1, math.ceil(alto * escala)))
        img.set_device_scale(escala, escala)
        cr = cairo.Context(img)
        for t in self.paginas[pagina]:
            t.dibujar(cr)
        self.cache = (clave, img)
        return img

    def _empezar(self, gesto, x, y):
        e = self.estado
        if not e["escribir"]:
            return
        h = e["herramienta"]
        self.actual = Trazo(h, e["color"], ANCHOS[h][e["grosor"] - 1], x, y)
        self.borrados = False
        if h == "laser":
            self.lasers.append(self.actual)
            self._animar()
        elif h == "borrador":
            self._borrar_en(x, y)
        self.area.queue_draw()

    def _seguir(self, gesto, dx, dy):
        if not self.actual:
            return
        ok, x0, y0 = gesto.get_start_point()
        x, y = x0 + dx, y0 + dy
        px, py = self.actual.puntos[-1]
        if self.actual.herramienta in ("flecha", "recuadro"):
            self.actual.puntos[1:] = [(x, y)]
        elif math.hypot(x - px, y - py) >= 1.5:
            self.actual.puntos.append((x, y))
        if self.actual.herramienta == "borrador":
            self._borrar_en(x, y)
        self.area.queue_draw()

    def _terminar(self, gesto, dx, dy):
        t, self.actual = self.actual, None
        if t is None:
            return
        pagina = self._pagina()
        if t.herramienta == "laser":
            t.fin = time.monotonic()
        elif t.herramienta == "borrador":
            if self.borrados:
                self._cambio()
        elif t.herramienta in ("flecha", "recuadro") and len(t.puntos) < 2:
            pass
        else:
            self._guardar_historial(pagina)
            self.paginas[pagina].append(t)
            self._cambio()
        self.area.queue_draw()

    def _borrar_en(self, x, y):
        pagina = self._pagina()
        radio = self.actual.ancho / 2
        quedan = [t for t in self.paginas[pagina] if not t.toca(x, y, radio)]
        if len(quedan) != len(self.paginas[pagina]):
            if not self.borrados:
                self._guardar_historial(pagina)
                self.borrados = True
            self.paginas[pagina] = quedan
            self.cache = None

    def _animar(self):
        if not self.tic:
            self.tic = self.area.add_tick_callback(self._paso_laser)

    def _paso_laser(self, area, _reloj):
        ahora = time.monotonic()
        self.lasers = [t for t in self.lasers
                       if t.fin is None or ahora - t.fin < LASER_VIVE_S + LASER_APAGA_S]
        area.queue_draw()
        if self.lasers:
            return True
        self.tic = 0
        self._actualizar()
        return False


if __name__ == "__main__":
    sys.exit(Pizarra().run([sys.argv[0]]))
