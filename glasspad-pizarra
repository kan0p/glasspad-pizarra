import os, sys

BUS = "io.github.kan0p.GlassPad.Pizarra"
RUTA = "/io/github/kan0p/GlassPad/Pizarra"
INTERFAZ = "io.github.kan0p.GlassPad.Pizarra"


def cliente(args):
    from gi.repository import Gio, GLib
    bus = Gio.bus_get_sync(Gio.BusType.SESSION)

    def llamar(metodo, params=None, tipo=None):
        return bus.call_sync(BUS, RUTA, INTERFAZ, metodo, params,
                             GLib.VariantType(tipo) if tipo else None,
                             Gio.DBusCallFlags.NONE, 5000, None)

    try:
        if args[0] == "alternar" and len(args) == 2 and args[1] in ("escribir",):
            estado = llamar("Estado", None, "(a{sv})").unpack()[0]
            llamar("Ajustar", GLib.Variant("(a{sv})", (
                {args[1]: GLib.Variant("b", not estado[args[1]])},)))
        elif args == ["deshacer"]:
            llamar("Deshacer")
        elif args == ["borrar"]:
            llamar("Borrar")
        elif args == ["apagar"]:
            llamar("ApagarTodo")
        else:
            print("uso: glasspad-pizarra alternar escribir | deshacer | borrar | apagar",
                  file=sys.stderr)
            return 2
    except GLib.Error as e:
        print(f"glasspad-pizarra: {e.message}", file=sys.stderr)
        return 1
    return 0


if len(sys.argv) > 1 and not sys.argv[1].startswith("-"):
    sys.exit(cliente(sys.argv[1:]))

