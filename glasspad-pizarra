def normalizar(atajo):
    """'alt+Super+E' -> 'super+alt+e': mismo orden de modificadores que el lector."""
    partes = [p.strip().lower() for p in atajo.split("+") if p.strip()]
    mods = [m for m in MODS_ORDEN if m in partes]
    resto = [DE_KEYSYM.get(p, p) for p in partes if p not in MODS_ORDEN]
    return "+".join(mods + resto[-1:])


def atajos_cosmic(texto):
    """{atajo normalizado: acción} de un archivo de atajos de COSMIC."""
    salida = {}
    for mods, tecla, accion in RE_ATAJO_COSMIC.findall(texto):
        partes = [m.strip() for m in mods.split(",") if m.strip()]
        if tecla:
            partes.append(tecla)
        salida[normalizar("+".join(partes))] = accion.strip()
    return salida


def leer(ruta):
    try:
        with open(ruta) as f:
            return f.read()
    except OSError:
        return ""


def entrada_cosmic(atajo, programa, args):
    partes = atajo.split("+")
    mods = ", ".join(m.capitalize() for m in partes[:-1])
    tecla = partes[-1]
    if tecla in MODS_ORDEN:
        mods = ", ".join(m.capitalize() for m in partes)
        return f'    (modifiers: [{mods}]): Spawn("{programa} {args}"),\n'
    tecla = KEYSYMS.get(tecla, tecla.upper() if re.fullmatch(r"f\d+", tecla) else tecla)
    return f'    (modifiers: [{mods}], key: "{tecla}"): Spawn("{programa} {args}"),\n'


