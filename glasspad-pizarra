def rgb(hexa):
    return tuple(int(hexa[i:i + 2], 16) / 255 for i in (1, 3, 5))


def leer_estado():
    estado = dict(PREDETERMINADO)
    try:
        with open(ESTADO) as f:
            guardado = json.load(f)
        for k in GUARDADOS:
            if k in guardado and valido(k, guardado[k]):
                estado[k] = guardado[k]
    except (OSError, ValueError):
        pass
    return estado


def guardar_estado(estado):
    os.makedirs(os.path.dirname(ESTADO), exist_ok=True)
    tmp = ESTADO + ".tmp"
    with open(tmp, "w") as f:
        json.dump({k: estado[k] for k in GUARDADOS}, f, indent=1)
    os.replace(tmp, ESTADO)


def valido(clave, valor):
    entero = lambda v, a, b: isinstance(v, int) and not isinstance(v, bool) and a <= v <= b
    return {"escribir": lambda v: isinstance(v, bool),
            "borrar_al_pasar": lambda v: isinstance(v, bool),
            "foco": lambda v: isinstance(v, bool),
            "anillo": lambda v: isinstance(v, bool),
            "radio": lambda v: entero(v, *RADIO),
            "oscuro": lambda v: entero(v, *OSCURO),
            "herramienta": lambda v: v in HERRAMIENTAS,
            "color": lambda v: v in COLORES,
            "grosor": lambda v: entero(v, 1, 3),
            "fondo": lambda v: v in FONDOS,
            "teclas": lambda v: isinstance(v, bool),
            "windows": lambda v: isinstance(v, bool),
            "clics": lambda v: isinstance(v, bool),
            "posicion": lambda v: v in POSICIONES,
            "tamano": lambda v: v in TAMANOS,
            "atajos": lambda v: isinstance(v, dict) and all(
                k in ACCIONES and isinstance(a, str) and a for k, a in v.items()),
            }.get(clave, lambda v: False)(valor)


def variante(v):
    if isinstance(v, dict):
        return GLib.Variant("a{ss}", {str(k): str(a) for k, a in v.items()})
    if isinstance(v, bool):
        return GLib.Variant("b", v)
    if isinstance(v, int):
        return GLib.Variant("i", v)
    return GLib.Variant("s", str(v))


def distancia_segmento(px, py, ax, ay, bx, by):
    dx, dy = bx - ax, by - ay
    largo = dx * dx + dy * dy
    t = 0 if largo == 0 else max(0, min(1, ((px - ax) * dx + (py - ay) * dy) / largo))
    return math.hypot(px - ax - t * dx, py - ay - t * dy)


def buscar_pad_conector():
    try:
        with open(CONECTOR_PAD) as f:
            return f.read().strip()
    except OSError:
        return ""


def monitor_principal():
    """El primer monitor que no es el ScreenPad, prefiriendo el panel interno."""
    pad = buscar_pad_conector()
    monitores = Gdk.Display.get_default().get_monitors()
    candidatos = []
    for i in range(monitores.get_n_items()):
        m = monitores.get_item(i)
        if m.get_connector() == pad or (not pad and "Toshiba" in (m.get_manufacturer() or "")):
            continue
        candidatos.append(m)
    candidatos.sort(key=lambda m: not (m.get_connector() or "").startswith("eDP"))
    return candidatos[0] if candidatos else None


class Foco:
    """El foco que sigue al cursor, con su propia conexión Wayland y sin GTK.

    El compositor solo informa la posición del cursor mientras se captura su imagen
    (ext-image-copy-capture-v1, 24x24 px), así que se pide una captura por cuadro.
    El oscurecido es una capa con dos búferes de memoria compartida: en cada cuadro se
    repinta y se marca como dañado solo el cuadrado alrededor del círculo.
    """

    BORDE = 3           # px de degradado a cada lado del radio
    ANILLO = 2
    ONDA_S = 0.35       # duración de la marca de un clic
    ONDAS = {"izquierdo": (0.96, 0.78, 0.30), "derecho": (0.42, 0.66, 1.0),
             "medio": (1.0, 1.0, 1.0)}

    def __init__(self, conector, escala, ajustes, al_fallar):
        self.conector = conector
        self.escala = escala
        self.ajustes = ajustes          # dict con radio, oscuro y anillo; se lee en cada cuadro
        self.al_fallar = al_fallar      # al_fallar(texto) si el foco no puede seguir
        self.s = None

    def _fallar(self, texto):
        log("foco:", texto)
        self.detener()
        self.al_fallar(texto)

    # ----- conexión ----------------------------------------------------------

    def iniciar(self):
        if self.s:
            return
        ruta = os.path.join(os.environ.get("XDG_RUNTIME_DIR", ""),
                            os.environ.get("WAYLAND_DISPLAY", "wayland-0"))
        try:
            self.s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            self.s.connect(ruta)
        except OSError as e:
            self.s = None
            self._fallar(f"No se pudo conectar a Wayland: {e.strerror}")
            return
        self.s.setblocking(False)
        self.buf = b""
        self.prox = 1
        self.globales = {}          # interfaz -> [(nombre, versión)]
        self.salidas = {}           # id de wl_output -> conector
        self.objetos = {}           # id -> tipo
        self.pos = None             # px del búfer
        self.tam_cursor = self.formato = self.buffer_cursor = None
        self.frame = None
        self.espera = 0
        self.quieto = 0             # capturas seguidas sin que se mueva el cursor
        self.bufs = []
        self.mostrada = None        # caja del círculo en el último búfer enviado
        self.cuadro = False         # hay un wl_callback de cuadro pendiente
        self.sucio = False
        self.mapa = None
        self.sello = None           # (clave de ajustes, ImageSurface del círculo)
        self.ondas = []             # (inicio, color) de los clics que se están marcando
        self.registro = self._nuevo("registro")
        self._enviar(1, 1, struct.pack("<I", self.registro))
        self._sync("globales")
        self.vigia = GLib.io_add_watch(self.s.fileno(), GLib.PRIORITY_DEFAULT,
                                       GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self._leer)
        debug("foco: encendido en", self.conector)

    def detener(self):
        if not self.s:
            return
        GLib.source_remove(self.vigia)
        if self.espera:
            GLib.source_remove(self.espera)
        self.s.close()
        self.s = None
        self.bufs = []
        if self.mapa:
            self.mapa.close()
            self.mapa = None
        debug("foco: apagado")

    def clic(self, boton):
        if self.s and boton in self.ONDAS:
            self.ondas.append((time.monotonic(), self.ONDAS[boton]))
            self._pedir_cuadro()

    def repintar(self):
        """Los ajustes cambiaron: se repinta todo en ambos búferes."""
        for b in self.bufs:
            b["completo"] = True
        self._pedir_cuadro()

    def _nuevo(self, tipo):
        self.prox += 1
        self.objetos[self.prox] = tipo
        return self.prox

    def _enviar(self, obj, op, datos=b"", fd=None):
        msg = struct.pack("<IHH", obj, op, 8 + len(datos)) + datos
        try:
            if fd is None:
                self.s.sendall(msg)
            else:
                self.s.sendmsg([msg], [(socket.SOL_SOCKET, socket.SCM_RIGHTS,
                                        array.array("i", [fd]))])
        except OSError as e:
            GLib.idle_add(lambda: self.s and self._fallar(f"Error de Wayland: {e.strerror}") and False)

    def _sync(self, para):
        self._enviar(1, 0, struct.pack("<I", self._nuevo("sync:" + para)))

    def _enlazar(self, interfaz, version, nombre=None):
        disponible = self.globales[interfaz][0]
        nombre = nombre or disponible[0]
        texto = interfaz.encode() + b"\0"
        texto += b"\0" * (-len(texto) % 4)
        nuevo = self._nuevo(interfaz)
        self._enviar(self.registro, 0, struct.pack("<II", nombre, len(interfaz) + 1) + texto
                     + struct.pack("<II", min(version, disponible[1]), nuevo))
        return nuevo

    @staticmethod
    def _texto(t):
        b = t.encode() + b"\0"
        return struct.pack("<I", len(b)) + b + b"\0" * (-len(b) % 4)

    def _leer(self, _fd, condicion):
        if condicion & (GLib.IO_HUP | GLib.IO_ERR):
            self._fallar("El escritorio cerró la conexión")
            return False
        try:
            datos = self.s.recv(65536)
        except BlockingIOError:
            return True
        except OSError:
            datos = b""
        if not datos:
            self._fallar("El escritorio cerró la conexión")
            return False
        self.buf += datos
        while len(self.buf) >= 8:
            obj, op, tam = struct.unpack("<IHH", self.buf[:8])
            if len(self.buf) < tam:
                break
            cuerpo, self.buf = self.buf[8:tam], self.buf[tam:]
            self._evento(obj, op, cuerpo)
            if not self.s:
                return False
        return True

    # ----- eventos -----------------------------------------------------------

    def _evento(self, obj, op, b):
        tipo = self.objetos.get(obj)
        if obj == 1:
            if op == 0:
                largo = struct.unpack("<I", b[8:12])[0]
                self._fallar("El escritorio rechazó el foco: "
                             + b[12:12 + largo - 1].decode(errors="replace"))
            elif op == 1:
                self.objetos.pop(struct.unpack("<I", b)[0], None)
        elif tipo == "registro" and op == 0:
            nombre, largo = struct.unpack("<II", b[:8])
            interfaz = b[8:8 + largo - 1].decode()
            version = struct.unpack("<I", b[8 + ((largo + 3) & ~3):][:4])[0]
            self.globales.setdefault(interfaz, []).append((nombre, version))
        elif tipo == "sync:globales":
            faltan = [i for i in ("wl_compositor", "wl_shm", "wl_seat", "wl_output",
                                  "zwlr_layer_shell_v1", "wp_viewporter",
                                  "ext_image_copy_capture_manager_v1",
                                  "ext_output_image_capture_source_manager_v1")
                      if i not in self.globales]
            if faltan:
                self._fallar("Este escritorio no es compatible (le falta "
                             + ", ".join(faltan) + ")")
                return
            for nombre, _v in self.globales["wl_output"]:
                self.salidas[self._enlazar("wl_output", 4, nombre)] = None
            self._sync("salidas")
        elif tipo == "wl_output" and op == 4:
            largo = struct.unpack("<I", b[:4])[0]
            self.salidas[obj] = b[4:4 + largo - 1].decode()
        elif tipo == "sync:salidas":
            self._crear()
        elif tipo == "capa":
            if op == 0:
                serie, ancho, alto = struct.unpack("<III", b)
                self._enviar(obj, 6, struct.pack("<I", serie))
                self._buferes(ancho, alto)
            elif op == 1:
                self._fallar("El escritorio cerró la capa del foco")
        elif tipo == "cuadro":
            self.cuadro = False
            if self.sucio:
                self._pintar()
        elif tipo == "buffer" and op == 0:
            for bb in self.bufs:
                if bb["id"] == obj:
                    bb["ocupado"] = False
            if self.sucio and not self.cuadro:
                self._pintar()
        elif tipo == "cursor" and op == 2:
            # al salir de la salida (al pad) el foco se queda donde estaba
            pos = struct.unpack("<ii", b)
            if pos != self.pos:
                self.pos = pos
                self.quieto = 0
                self._pedir_cuadro()
        elif tipo == "captura":
            if op == 0:
                self.tam_cursor = struct.unpack("<II", b)
            elif op == 1 and self.formato is None:
                self.formato = struct.unpack("<I", b)[0]
            elif op == 4:
                self._buffer_cursor()
                if not self.frame:
                    self._capturar()
            elif op == 5:
                self._fallar("El escritorio dejó de informar la posición del cursor")
        elif tipo == "frame" and op in (3, 4):
            self._enviar(obj, 0)
            self.frame = None
            # si falla, el compositor manda otro "done" con los límites nuevos o se reintenta
            self.quieto += 1
            pausa = CAPTURA_QUIETO_MS if self.quieto > QUIETO else CAPTURA_MS
            self.espera = GLib.timeout_add(pausa if op == 3 else 500, self._capturar)

    # ----- capa del oscurecido ----------------------------------------------

    def _crear(self):
        self.salida = next((o for o, n in self.salidas.items() if n == self.conector), None)
        if self.salida is None:
            self._fallar(f"No se encontró la pantalla {self.conector}")
            return
        compositor = self._enlazar("wl_compositor", 4)
        self.shm = self._enlazar("wl_shm", 1)
        capas = self._enlazar("zwlr_layer_shell_v1", 4)
        vistas = self._enlazar("wp_viewporter", 1)
        self.superficie = self._nuevo("superficie")
        self._enviar(compositor, 0, struct.pack("<I", self.superficie))
        region = self._nuevo("region")
        self._enviar(compositor, 1, struct.pack("<I", region))
        # región de entrada vacía: los clics pasan a la presentación
        self._enviar(self.superficie, 5, struct.pack("<I", region))
        self._enviar(region, 0)
        self.vista = self._nuevo("vista")
        self._enviar(vistas, 1, struct.pack("<II", self.vista, self.superficie))
        capa = self._nuevo("capa")
        self._enviar(capas, 0, struct.pack("<IIII", capa, self.superficie, self.salida, 3)
                     + self._texto("glasspad-foco"))
        self._enviar(capa, 1, struct.pack("<I", 15))         # los cuatro bordes
        self._enviar(capa, 2, struct.pack("<i", -1))
        self._enviar(capa, 4, struct.pack("<I", 0))          # sin teclado
        self._enviar(self.superficie, 6)

        asiento = self._enlazar("wl_seat", 5)
        fuentes = self._enlazar("ext_output_image_capture_source_manager_v1", 1)
        capturas = self._enlazar("ext_image_copy_capture_manager_v1", 1)
        puntero = self._nuevo("wl_pointer")
        self._enviar(asiento, 0, struct.pack("<I", puntero))
        fuente = self._nuevo("fuente")
        self._enviar(fuentes, 0, struct.pack("<II", fuente, self.salida))
        cursor = self._nuevo("cursor")
        self._enviar(capturas, 1, struct.pack("<III", cursor, fuente, puntero))
        self.sesion = self._nuevo("captura")
        self._enviar(cursor, 1, struct.pack("<I", self.sesion))

    def _buferes(self, ancho, alto):
        w, h = max(1, round(ancho * self.escala)), max(1, round(alto * self.escala))
        if self.bufs and (self.w, self.h) == (w, h):
            return
        self.w, self.h = w, h
        for bb in self.bufs:
            self._enviar(bb["id"], 0)
        if self.mapa:
            self._enviar(self.pool, 1)
            self.mapa.close()
        paso = w * 4
        tam = paso * h
        fd = os.memfd_create("glasspad-foco", os.MFD_CLOEXEC)
        os.ftruncate(fd, 2 * tam)
        self.mapa = mmap.mmap(fd, 2 * tam)
        self.pool = self._nuevo("pool")
        self._enviar(self.shm, 0, struct.pack("<Ii", self.pool, 2 * tam), fd=fd)
        os.close(fd)
        self.bufs = []
        for i in range(2):
            ident = self._nuevo("buffer")
            # formato 0: ARGB8888 premultiplicado, igual que cairo
            self._enviar(self.pool, 0, struct.pack("<IiiiiI", ident, i * tam, w, h, paso, 0))
            sup = cairo.ImageSurface.create_for_data(
                memoryview(self.mapa)[i * tam:(i + 1) * tam], cairo.FORMAT_ARGB32, w, h, paso)
            self.bufs.append({"id": ident, "sup": sup, "ocupado": False, "completo": True,
                              "caja": None})
        self._enviar(self.vista, 2, struct.pack("<ii", ancho, alto))
        self.mostrada = None
        self.sucio = True
        self._pintar()

    def _pedir_cuadro(self):
        self.sucio = True
        if not self.cuadro:
            self._pintar()

    def _lado(self):
        return math.ceil((self.ajustes["radio"] + self.BORDE + self.ANILLO + 2) * self.escala)

    def _centro(self):
        x, y = self.pos or (self.w / 2, self.h / 2)
        return round(x), round(y)

    def _caja(self):
        x, y = self._centro()
        lado = self._lado()
        x0, y0 = max(0, x - lado), max(0, y - lado)
        x1, y1 = min(self.w, x + lado), min(self.h, y + lado)
        return x0, y0, max(x0, x1), max(y0, y1)

    def _oscuro(self):
        return (0.03, 0.04, 0.06, self.ajustes["oscuro"] / 100)

    def _circulo(self):
        """El cuadrado con el círculo, dibujado una vez por cada combinación de ajustes."""
        e = self.ajustes
        clave = (e["radio"], e["oscuro"], e["anillo"], self.escala)
        if self.sello and self.sello[0] == clave:
            return self.sello[1]
        lado = self._lado()
        sup = cairo.ImageSurface(cairo.FORMAT_ARGB32, 2 * lado, 2 * lado)
        cr = cairo.Context(sup)
        oscuro = self._oscuro()
        r, borde = e["radio"] * self.escala, self.BORDE * self.escala
        g = cairo.RadialGradient(lado, lado, max(0, r - borde), lado, lado, r + borde)
        g.add_color_stop_rgba(0, *oscuro[:3], 0)
        g.add_color_stop_rgba(1, *oscuro)
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source(g)
        cr.paint()
        if e["anillo"]:
            cr.set_operator(cairo.OPERATOR_OVER)
            cr.arc(lado, lado, r, 0, 2 * math.pi)
            cr.set_source_rgba(0.96, 0.78, 0.30, 0.65)
            cr.set_line_width(self.ANILLO * self.escala)
            cr.stroke()
        sup.flush()
        self.sello = (clave, sup)
        return sup

    def _pintar(self):
        if not self.s or not self.bufs:
            return
        libres = [bb for bb in self.bufs if not bb["ocupado"]]
        if not libres:
            return          # se pinta cuando el compositor suelte uno
        bb = libres[0]
        self.sucio = False
        caja = self._caja()
        completo = bb["completo"] or bb["caja"] is None
        cr = cairo.Context(bb["sup"])
        if not completo:
            for x0, y0, x1, y1 in (bb["caja"], caja):
                cr.rectangle(x0, y0, x1 - x0, y1 - y0)
            cr.clip()
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(*self._oscuro())
        cr.paint()
        x, y = self._centro()
        lado = self._lado()
        cr.set_source_surface(self._circulo(), x - lado, y - lado)
        cr.rectangle(caja[0], caja[1], caja[2] - caja[0], caja[3] - caja[1])
        cr.fill()
        ahora = time.monotonic()
        self.ondas = [(t, c) for t, c in self.ondas if ahora - t < self.ONDA_S]
        cr.set_operator(cairo.OPERATOR_OVER)
        for t, color in self.ondas:
            f = (ahora - t) / self.ONDA_S
            cr.arc(x, y, (8 + 30 * f) * self.escala, 0, 2 * math.pi)
            cr.set_source_rgba(*color, 0.85 * (1 - f))
            cr.set_line_width(3 * self.escala)
            cr.stroke()
        bb["sup"].flush()
        bb["completo"] = False
        bb["caja"] = caja
        bb["ocupado"] = True

        self._enviar(self.superficie, 1, struct.pack("<Iii", bb["id"], 0, 0))
        if completo or self.mostrada is None:
            danos = [(0, 0, self.w, self.h)]
        else:
            danos = [self.mostrada, caja]
        for x0, y0, x1, y1 in danos:
            self._enviar(self.superficie, 9, struct.pack("<iiii", x0, y0, x1 - x0, y1 - y0))
        self.cuadro = True
        self._enviar(self.superficie, 3, struct.pack("<I", self._nuevo("cuadro")))
        self._enviar(self.superficie, 6)
        self.mostrada = caja
        if self.ondas:
            self.sucio = True       # el próximo cuadro sigue la animación

    # ----- cursor ------------------------------------------------------------

    def _buffer_cursor(self):
        if self.buffer_cursor:
            self._enviar(self.buffer_cursor, 0)
            self._enviar(self.pool_cursor, 1)
        w, h = self.tam_cursor
        tam = max(4, w * h * 4)
        fd = os.memfd_create("glasspad-cursor", os.MFD_CLOEXEC)
        os.ftruncate(fd, tam)
        self.pool_cursor = self._nuevo("pool")
        self._enviar(self.shm, 0, struct.pack("<Ii", self.pool_cursor, tam), fd=fd)
        os.close(fd)
        self.buffer_cursor = self._nuevo("buffer-cursor")
        self._enviar(self.pool_cursor, 0, struct.pack("<IiiiiI", self.buffer_cursor, 0, w, h,
                                                      w * 4, self.formato or 0))

    def _capturar(self):
        self.espera = 0
        if not self.s or not self.buffer_cursor:
            return False
        self.frame = self._nuevo("frame")
        self._enviar(self.sesion, 0, struct.pack("<I", self.frame))
        self._enviar(self.frame, 1, struct.pack("<I", self.buffer_cursor))
        w, h = self.tam_cursor
        self._enviar(self.frame, 2, struct.pack("<iiii", 0, 0, w, h))
        self._enviar(self.frame, 3)
        return False


