    except (OSError, ValueError, IndexError):
        return "us"
    return valor.split(",")[0].strip() or "us"


def nombre_tecla(codigo, signos):
    """KEY_T -> 't', KEY_F5 -> 'f5', KEY_SLASH -> 'minus' en latam."""
    if codigo in ("super", "ctrl", "alt", "shift"):
        return codigo
    if codigo in TECLAS_FIJAS:
        return TECLAS_FIJAS[codigo]
    if codigo in signos:
        return signos[codigo]
    n = codigo.removeprefix("KEY_").removeprefix("BTN_").lower()
    return n


def etiquetas(atajo, windows):
    """'super+shift+t' -> ['⊞ Win', 'Shift', 'T'] o ['Super', 'Shift', 'T']."""
    salida = []
    for p in atajo.split("+"):
        if p in ("super", "win"):
            salida.append(ETIQUETAS["win"] if windows else "Super")
        elif p in ETIQUETAS:
            salida.append(ETIQUETAS[p])
        else:
            salida.append(p.upper() if len(p) == 1 else p.capitalize())
    return salida


class Lector:
    """El ayudante de root que lee el teclado, abierto con pkexec mientras haga falta."""

    def __init__(self, al_atajo, al_clic, al_fallar):
        self.al_atajo = al_atajo
        self.al_clic = al_clic
        self.al_fallar = al_fallar
        self.proc = None

    def encender(self):
        if self.proc:
            return
        ayudante = next((r for r in AYUDANTES if os.access(r, os.X_OK)), None)
        if not ayudante:
            self.al_fallar("Falta la parte del sistema: sudo ./install.sh --sistema")
            return
        try:
            self.proc = Gio.Subprocess.new(["pkexec", ayudante], Gio.SubprocessFlags.STDIN_PIPE
                                           | Gio.SubprocessFlags.STDOUT_PIPE)
        except GLib.Error as e:
            self.al_fallar(f"No se pudo abrir el lector de teclas: {e.message}")
            return
        self.cancelar = Gio.Cancellable()
        self.entrada = Gio.DataInputStream.new(self.proc.get_stdout_pipe())
        self._leer()
        self.proc.wait_async(None, self._termino)
        debug("teclas: lector abierto")

    def apagar(self):
        if not self.proc:
            return
        proc, self.proc = self.proc, None
        self.cancelar.cancel()
        # el ayudante corre como root: no se le puede mandar una señal, sale al cerrar su entrada
        proc.get_stdin_pipe().close()
        debug("teclas: lector cerrado")

    def _leer(self):
        self.entrada.read_line_async(GLib.PRIORITY_DEFAULT, self.cancelar, self._linea)

    def _linea(self, flujo, res):
        try:
            linea, _largo = flujo.read_line_finish_utf8(res)
        except GLib.Error:
            return
        if linea is None:
            return
        tipo, _, dato = linea.partition(" ")
        if tipo == "atajo":
            self.al_atajo(dato)
        elif tipo == "clic":
            self.al_clic(dato)
        self._leer()

    def _termino(self, proc, res):
        try:
            proc.wait_finish(res)
        except GLib.Error:
            pass
        if proc is not self.proc:
            return          # se cerró a propósito
        self.proc = None
        codigo = proc.get_exit_status() if proc.get_if_exited() else -1
        self.al_fallar("Sin permiso para leer el teclado" if codigo in (126, 127)
                       else f"El lector de teclas se cerró ({codigo})")


