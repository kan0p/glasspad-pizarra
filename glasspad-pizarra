CONECTOR_PAD = "/var/lib/screenpad/conector"     # lo deja "screenpad on" de GlassPad

HERRAMIENTAS = {"lapiz": "Lápiz", "resaltador": "Resaltador", "laser": "Láser",
                "flecha": "Flecha", "recuadro": "Recuadro", "borrador": "Borrador"}
COLORES = {"rojo": "#ff5a4e", "amarillo": "#ffd23f", "verde": "#3ddc84",
           "azul": "#4c9bff", "blanco": "#ffffff", "negro": "#111111"}
FONDOS = {"transparente": None, "blanca": (0.98, 0.98, 0.97), "negra": (0.11, 0.125, 0.15)}
# ancho del trazo en px por grosor (1, 2, 3)
ANCHOS = {"lapiz": (3, 6, 11), "resaltador": (16, 28, 44), "laser": (4, 7, 11),
          "flecha": (3, 6, 10), "recuadro": (3, 6, 10), "borrador": (14, 26, 44)}
LASER_VIVE_S = 1.0       # visible entero después de soltar
LASER_APAGA_S = 0.5      # y luego se desvanece
HISTORIAL = 100
AVISO_S = 2.5

PREDETERMINADO = {"escribir": False, "herramienta": "lapiz", "color": "rojo", "grosor": 2,
                  "fondo": "transparente", "borrar_al_pasar": True}
GUARDADOS = ("herramienta", "color", "grosor", "fondo", "borrar_al_pasar")

XML = f"""
